{
  "manifest_version": 3,
  "name": "ClipDrop — Video Finder",
  "version": "1.0.0",
  "description": "Find exposed video files on the current page and download them, or open supported pages in ClipDrop.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {"default_popup": "popup.html", "default_title": "Find videos with ClipDrop", "default_icon": {"16":"icons/16.png","32":"icons/32.png"}},
  "icons": {"16":"icons/16.png","48":"icons/48.png","128":"icons/128.png"},
  "homepage_url": "https://clipdrop-video-downloader.netlify.app/extension"
}
